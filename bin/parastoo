#!/usr/bin/env bash
# parastoo — Parastoo command-line management tool (English output: SSH-safe)
set -euo pipefail

DIR_FILE="/etc/parastoo-install-path"
if [ -f "$DIR_FILE" ]; then
  APP_DIR="$(cat "$DIR_FILE")"
else
  APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

usage() {
  cat <<'EOF'
Parastoo — management commands:

  parastoo status          service status
  parastoo logs [svc]      show logs (core | gitea | traefik | postgres)
  parastoo restart         restart the whole stack
  parastoo update          update from GitHub (pull latest code + rebuild the core)
  parastoo autoupdate      auto-update control: status | on | off | run
  parastoo backup          back up the database and git repos into backups/
  parastoo reset           FACTORY RESET: wipe all data (users, projects, repos, sites) and re-run the setup wizard
  parastoo doctor          full diagnostic report (secrets redacted) — share it when asking for help
  parastoo version         Parastoo version + deployed commit
  parastoo help            this help
EOF
}

cd "$APP_DIR"

case "${1:-help}" in
  status)
    docker compose ps
    echo ""
    docker compose exec -T core curl -fsS http://localhost:8000/healthz 2>/dev/null && echo "" || echo "Parastoo core is not responding"
    ;;
  logs)
    docker compose logs -f --tail 100 "${2:-core}"
    ;;
  restart)
    docker compose restart
    ;;
  update)
    # آپدیت از گیت‌هاب: کد جدید + بازسازی (نصب اولیه دستی است، آپدیت خودکارِ همان مسیر)
    CH="$(grep -E '^PARASTOO_UPDATE_CHANNEL=' .env 2>/dev/null | cut -d= -f2-)"
    echo "Updating Parastoo from GitHub (channel: ${CH:-main})..."
    if bash "$APP_DIR/scripts/auto-update.sh" --force; then
      echo "Done."
    else
      echo "Auto-update could not reach GitHub; rebuilding the current code only..."
      docker compose build core
      docker compose up -d
      echo "Done (local rebuild)."
    fi
    ;;
  autoupdate)
    case "${2:-status}" in
      status)
        echo "Config:      $(grep -E '^PARASTOO_AUTO_UPDATE=' .env 2>/dev/null || echo 'PARASTOO_AUTO_UPDATE=true (default)')"
        echo "Interval:    $(grep -E '^PARASTOO_AUTO_UPDATE_INTERVAL=' .env 2>/dev/null | cut -d= -f2- || echo 120)s   Channel: $(grep -E '^PARASTOO_UPDATE_CHANNEL=' .env 2>/dev/null | cut -d= -f2- || echo main)"
        echo "Deployed:    $(tr '\n' ' ' < "$APP_DIR/.parastoo-deploy" 2>/dev/null || echo 'unknown')"
        if command -v systemctl >/dev/null 2>&1; then
          echo "Timer:       $(systemctl is-enabled parastoo-autoupdate.timer 2>/dev/null || echo 'not installed') / $(systemctl is-active parastoo-autoupdate.timer 2>/dev/null || echo '-')"
        fi
        echo "Last updates:"
        tail -5 "$APP_DIR/logs/updates.jsonl" 2>/dev/null || echo "  (no update history yet)"
        ;;
      on|off)
        [ -f .env ] || { echo "ERROR: .env not found in $APP_DIR"; exit 1; }
        VAL=$([ "$2" = "on" ] && echo true || echo false)
        if grep -qE '^PARASTOO_AUTO_UPDATE=' .env; then
          sed -i "s/^PARASTOO_AUTO_UPDATE=.*/PARASTOO_AUTO_UPDATE=$VAL/" .env
        else
          echo "PARASTOO_AUTO_UPDATE=$VAL" >> .env
        fi
        if command -v systemctl >/dev/null 2>&1; then
          systemctl daemon-reload 2>/dev/null || true
          if [ "$2" = "on" ]; then
            systemctl enable --now parastoo-autoupdate.timer 2>/dev/null || true
          else
            systemctl disable --now parastoo-autoupdate.timer 2>/dev/null || true
          fi
        fi
        echo "Auto-update is now $2."
        ;;
      run)
        bash "$APP_DIR/scripts/auto-update.sh" --force
        ;;
      *) usage ;;
    esac
    ;;
  backup)
    TS="$(date +%Y%m%d-%H%M%S)"
    mkdir -p backups
    echo "Backing up the database..."
    docker compose exec -T postgres pg_dump -U parastoo parastoo | gzip > "backups/db-${TS}.sql.gz"
    echo "Backing up git repositories..."
    # alpine:3.20 is pinned so sanction-less servers never need a latest pull from Docker Hub — deploy/images.txt
    docker run --rm -v parastoo_gitea_data:/data -v "$APP_DIR/backups":/backup alpine:3.20 \
      tar czf "/backup/gitea-${TS}.tar.gz" /data
    echo "Backup complete: backups/db-${TS}.sql.gz and backups/gitea-${TS}.tar.gz"
    ;;
  reset)
    echo "Factory reset: this PERMANENTLY deletes all Parastoo data —"
    echo "users, projects, git repositories, wallet, sites, build history."
    echo "The code, .env and backups/ are kept. This cannot be undone."
    read -r -p "Type 'reset' to continue: " CONFIRM
    [ "${CONFIRM:-}" = "reset" ] || { echo "Cancelled."; exit 0; }
    # site containers live OUTSIDE the compose stack (created via Docker SDK,
    # restart=unless-stopped) — compose down never touches them, remove first
    echo "Removing deployed site containers..."
    docker ps -aq --filter name=parastoo-site- | xargs -r docker rm -f
    echo "Stopping the stack and deleting data volumes..."
    docker compose down -v --remove-orphans
    echo "Removing project images..."
    docker images -q --filter label=parastoo.slug | xargs -r docker rmi -f
    echo "Starting a fresh stack..."
    docker compose up -d
    echo ""
    echo "Parastoo is back to factory state."
    echo "Open the panel and complete the setup wizard again."
    TOK="$(grep -E '^PARASTOO_SETUP_TOKEN=' .env 2>/dev/null | cut -d= -f2-)"
    echo "Setup token: ${TOK:-see $APP_DIR/.env (PARASTOO_SETUP_TOKEN)}"
    ;;
  doctor)
    bash "$APP_DIR/scripts/doctor.sh"
    ;;
  version)
    docker compose exec -T core curl -fsS http://localhost:8000/api/version 2>/dev/null \
      || docker compose exec -T core curl -fsS http://localhost:8000/healthz 2>/dev/null \
      || echo "Parastoo is not running"
    ;;
  help|--help|-h|*)
    usage
    ;;
esac
