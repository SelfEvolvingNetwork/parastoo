# پیکربندی استاتیک ترافیک — توسط install.sh از این الگو ساخته می‌شود
entryPoints:
  web:
    address: ":80"
__WEB_REDIRECT__
  websecure:
    address: ":443"

providers:
  docker:
    exposedByDefault: false
  file:
    directory: /etc/traefik/dynamic
    watch: true

api:
  dashboard: false

log:
  level: INFO

accessLog: {}

certificatesResolvers:
  le:
    acme:
      email: "__ACME_EMAIL__"
      storage: /letsencrypt/acme.json
__ACME_CASERVER__
__ACME_EAB__
      httpChallenge:
        entryPoint: web
  wild:
    # v0.3.33 — الگوی ساب‌دامنهٔ بی‌نهایت: گواهی وایلدکارد *.apps.<دامنه> با چالش
    # DNS-01 روی PDNS خودمان (ارائه‌دهندهٔ pdns lego، کلید از dns_meta) — همیشه
    # لت‌انکریپت، چون زروسsl شناسهٔ .ir را رد می‌کند و HTTP-01 اصلاً wildcard نمی‌پذیرد
    acme:
      email: "__ACME_EMAIL__"
      storage: /letsencrypt/acme.json
      dnsChallenge:
        provider: pdns
__ACME_RESOLVERS__
