# نمونه پیکربندی — install.sh همین فایل‌ها را به‌صورت خودکار می‌سازد
# فقط اگر می‌خواهید مقادیر را از قبل دستی بدهید، .env بسازید.

BASE_DOMAIN=example.com
PANEL_DOMAIN=panel.example.com
GIT_DOMAIN=git.example.com
APPS_DOMAIN=apps.example.com
TLS_ENABLED=true
ACME_EMAIL=admin@example.com
TRAEFIK_ENTRYPOINTS=web,websecure
TRAEFIK_TLS=true
GITEA_ROOT_URL=https://git.example.com/

POSTGRES_PASSWORD=change-me
GITEA_DB_PASSWORD=change-me
GITEA_SECRET_KEY=change-me
PARASTOO_SECRET=change-me
GITEA_ADMIN_USER=parastoo-system
GITEA_ADMIN_EMAIL=system@example.com
GITEA_ADMIN_PASSWORD=change-me

PARASTOO_TZ=Asia/Tehran
# سقف بدهی مجاز (تومان)؛ بعد از آن سایت‌ها متوقف می‌شوند
PARASTOO_DEBT_LIMIT=0
# کمیسیون پرستو از فروش ایمیج (درصد)
PARASTOO_COMMISSION=10

# --- آپدیت خودکار از گیت‌هاب (v0.2.12) ---
# نصب اولیه دستی است؛ بعد از آن هر push به شاخهٔ کانال = استقرار خودکار روی سرور
PARASTOO_AUTO_UPDATE=true
# حداقل فاصلهٔ بررسی گیت‌هاب (ثانیه؛ حداقل ۶۰)
PARASTOO_AUTO_UPDATE_INTERVAL=120
# شاخه یا تگ هدف آپدیت
PARASTOO_UPDATE_CHANNEL=main
# پراکسی گیت‌هاب برای سرورهای تحریمی، مثال: https://gh-proxy.com/
#PARASTOO_GH_PROXY=

# --- حالت توسعه‌دهنده (v0.2.12) ---
# صفحه /dev و API گزارش/لاگ/تاریخچهٔ آپدیت — فقط روی نصب آزمایشی true بگذارید.
# در حالت عادی (false) همهٔ مسیرهای /dev و /api/dev/* وجود ندارند (404).
PARASTOO_DEV_MODE=false
# توکن اختیاری برای دسترسی curl بدون لاگین: هدر X-Dev-Token یا ?token=
#PARASTOO_DEV_TOKEN=

# --- آخرین استقرار (install.sh/auto-update.sh می‌نویسند؛ دستی تغییر ندهید) ---
PARASTOO_DEPLOYED_COMMIT=
PARASTOO_DEPLOYED_AT=

# --- تحریم‌ها (اختیاری؛ install.sh خودش اگر لازم شد تشخیص و پر می‌کند) ---
# آینهٔ pip برای بیلد پایتون، مثال: https://package-mirror.liara.ir/repository/pypi/simple
#PARASTOO_PIP_INDEX_URL=
# رجیستری npm برای بیلد نود، مثال: https://registry.npmjs.ir
#PARASTOO_NPM_REGISTRY=
